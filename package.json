{
  "name": "nekodot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm -r build && pnpm spike:build",
    "spike:build": "esbuild scripts/spike-hermes.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/scripts/spike-hermes.mjs",
    "spike:steer:build": "esbuild scripts/spike-steer.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/scripts/spike-steer.mjs",
    "spike:hermes": "tsx scripts/spike-hermes.ts",
    "test:e2e": "playwright test",
    "node:pair": "tsx apps/node/src/index.ts pair",
    "node:run": "tsx apps/node/src/index.ts run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nekodot/fake-hermes": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
