@@ -0,0 +1,26 @@
+"""Expose a scheduled fire's native approval queue through its canonical session."""
+from contextlib import contextmanager
+
+
+@contextmanager
+def approval_scope(authority, session_id, generation, job_id):
+    from tools.approval import register_gateway_notify, unregister_gateway_notify
+    from tools.approval_context import set_current_session_key, reset_current_session_key, _get_approval_timeout
+    from cron.approval_policy import current_mode
+    from hermes_cli.config import load_config_readonly
+    if current_mode(load_config_readonly(), job_id=job_id) != "ask":
+        yield
+        return
+    route = "cron-approval:" + session_id
+    token = set_current_session_key(route)
+
+    def notify(data):
+        authority.register_approval(session_id, generation, route,
+            {**data, "allow_session": False, "allow_permanent": False}, timeout_s=_get_approval_timeout())
+
+    register_gateway_notify(route, notify)
+    try:
+        yield
+    finally:
+        unregister_gateway_notify(route)
+        reset_current_session_key(token)
