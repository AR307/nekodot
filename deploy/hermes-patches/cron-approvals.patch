+"""Per-job approval rules, evaluated in the user's configured timezone at each action."""
+from datetime import datetime, timedelta
+from zoneinfo import ZoneInfo
+
+POLICY_PENDING_REASON = "Approval policy needs confirmation."
+
+
+def effective_mode(policy, *, now=None):
+    local = (now or datetime.now(ZoneInfo(policy["timezone"]))).astimezone(ZoneInfo(policy["timezone"]))
+    minute = local.hour * 60 + local.minute
+    mode = policy["default"]
+    for window in policy.get("windows", []):
+        start, end = [int(value[:2]) * 60 + int(value[3:]) for value in (window["start"], window["end"])]
+        overnight = start > end
+        day = (local - timedelta(days=1)).weekday() if overnight and minute < end else local.weekday()
+        inside = (minute >= start or minute < end) if overnight else start <= minute < end
+        if inside and day in window["days"]:
+            mode = window["mode"]
+    return mode
+
+
+def current_mode(config, *, job_id=None):
+    from cron.execution_identity import current_cron_execution
+    execution = current_cron_execution() if job_id is None else None
+    job_id = job_id or (execution.job_id if execution else None)
+    approvals = config.get("approvals") or {}
+    policy = (approvals.get("cron_policies") or {}).get(job_id) if job_id else None
+    return effective_mode(policy) if policy else (
+        "ask" if approvals.get("cron_require_policy") else approvals.get("cron_mode", "deny"))
+
+
+def creation_requires_confirmation():
+    from hermes_cli.config import load_config_readonly
+    return (load_config_readonly().get("approvals") or {}).get("cron_require_policy", False)
