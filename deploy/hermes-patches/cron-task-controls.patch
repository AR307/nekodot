+def bind_agent(agent):
+    # Only canonical cron fires have an owning control queue; other cron entry points stay headless.
+    from gateway.session_cron import current_execution
+    current = current_execution()
+    if current is None:
+        return agent
+    authority, session_id, _, _ = current
+    from hermes_state_runtime import list_session_admissions
+    row = next(row for row in list_session_admissions(authority.db, session_id=session_id,
+               pending_only=True) if row['status'] == 'started')
+    generation = row['generation']
+    authority.adopt_agent(session_id, generation, agent)
+
+    def clarify(questions):
+        from uuid import uuid4
+        from tools.clarify_gateway import register, wait_for_response, get_clarify_timeout, CANCELLED, SKIPPED
+        answers = {}
+        outcome = 'submitted'
+        for question in questions:
+            entry = register(uuid4().hex, session_id, question['question'],
+                             question.get('choices'), question.get('multi_select', False))
+            authority.register_clarify(session_id, generation, entry, timeout_s=get_clarify_timeout())
+            answer = wait_for_response(entry.clarify_id, get_clarify_timeout())
+            authority.sessions[session_id].controls.snapshot(session_id, generation)
+            if answer is None or answer == CANCELLED:
+                outcome = 'cancelled' if answer == CANCELLED else 'timed_out'
+                break
+            answers[question['qid']] = None if answer == SKIPPED else answer
+        return {'answers': answers, 'outcome': outcome}
+
+    agent.clarify_callback = clarify
+    return agent
