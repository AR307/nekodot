JWT_SECRET=replace-with-a-local-random-secret
PUBLIC_URL=https://api.nekodot.com
CLIENT_ORIGINS=https://www.nekodot.com
COMPOSIO_API_KEY=
# Google and GitHub sign-in: each provider needs both values, or neither.
# Callbacks: https://api.nekodot.com/api/auth/oauth/google/callback and .../github/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Enable only after placing the service account file outside Git:
# GOOGLE_APPLICATION_CREDENTIALS=/run/nekodot-private/firebase-admin.json
