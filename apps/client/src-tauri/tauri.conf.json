{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "nekodot",
  "version": "0.1.0",
  "identifier": "app.nekodot.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4318",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "nekodot",
        "label": "main",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "useHttpsScheme": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "homepage": "https://nekodot.com",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 29,
      "versionCode": 1
    }
  }
}
